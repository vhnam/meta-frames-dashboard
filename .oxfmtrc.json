{
  "printWidth": 100,
  "trailingComma": "all",
  "tabWidth": 2,
  "overrides": [
    {
      "files": ["**/*.{ts,vue}"],
      "options": {
        "singleQuote": true
      }
    },
    {
      "files": ["src/**/*.{ts,vue}"],
      "options": {
        "sortImports": {
          "newlinesBetween": true,
          "groups": [
            "builtin",
            "external",
            "internal",
            ["parent", "sibling", "index", "style", "side_effect_style"],
            "unknown"
          ]
        }
      }
    }
  ],
  "singleAttributePerLine": true,
  "vueIndentScriptAndStyle": false,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/index.css",
    "functions": ["cn", "cva", "clsx"],
    "attributes": [":class"]
  }
}
